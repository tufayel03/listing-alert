{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listing-alert",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "LISTING_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
